    affiliation: >-
      Departamento de Informática y Computación, Facultad de Ingeniería,
      Universidad Tecnológica Metropolitana, Santiago, Chile
  - family-names: Sepúlveda Oehninger
    given-names: Daniel
    email: daniel.sepulveda@utem.cl
    orcid: https://orcid.org/0000-0002-3129-393X
    affiliation: >-
      Departamento de Matemática, Facultad de Ciencias Naturales,
      Matemática y Medio Ambiente, Universidad Tecnológica Metropolitana,
      Santiago, Chile

license: MIT
license-url: https://opensource.org/licenses/MIT
keywords:
  - hybrid dynamical models
  - Universal Differential Equations
  - latent dynamics
  - temporal supervision
  - mechanism recovery
  - scientific machine learning
  - epidemiological modeling
  - SIR
  - Julia

